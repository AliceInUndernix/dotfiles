-			nh = MAX(ev.xmotion.y - ocy - 2 * c->bw + 1, 1);
+			if (left) {
+				ex = c->x + c->w + 2 * c->bw;
+				nw = MAX(ex - ev.xmotion.x - 2 * c->bw, 1);
+			} else
+				nw = MAX(ev.xmotion.x - c->x - 2 * c->bw + 1, 1);
+			if (top) {
+				ey = c->y + c->h + 2 * c->bw;
+				nh = MAX(ey - ev.xmotion.y - 2 * c->bw, 1);
+			} else
+				nh = MAX(ev.xmotion.y - c->y - 2 * c->bw + 1, 1);
 			if (c->mon->wx + nw >= selmon->wx && c->mon->wx + nw <= selmon->wx + selmon->ww
 			&& c->mon->wy + nh >= selmon->wy && c->mon->wy + nh <= selmon->wy + selmon->wh)
 			{
@@ -1718,12 +1737,22 @@ resizemouse(const Arg *arg)
 				&& (abs(nw - c->w) > snap || abs(nh - c->h) > snap))
 					togglefloating(NULL);
 			}
-			if (!selmon->lt[selmon->sellt]->arrange || c->isfloating)
-				resize(c, c->x, c->y, nw, nh, 1);
+			if (!selmon->lt[selmon->sellt]->arrange || c->isfloating) {
+				/* apply size hints first, then move the dragged
+				 * edge so the opposite corner does not drift */
+				nx = c->x;
+				ny = c->y;
+				applysizehints(c, &nx, &ny, &nw, &nh, 1);
+				nx = left ? ex - nw - 2 * c->bw : c->x;
+				ny = top ? ey - nh - 2 * c->bw : c->y;
+				if (nx != c->x || ny != c->y || nw != c->w || nh != c->h)
+					resizeclient(c, nx, ny, nw, nh);
+			}
 			break;
 		}
 	} while (ev.type != ButtonRelease);
-	XWarpPointer(dpy, None, c->win, 0, 0, 0, 0, c->w + c->bw - 1, c->h + c->bw - 1);
+	XWarpPointer(dpy, None, c->win, 0, 0, 0, 0,
+		left ? -c->bw : c->w + c->bw - 1, top ? -c->bw : c->h + c->bw - 1);
 	XUngrabPointer(dpy, CurrentTime);
 	while (XCheckMaskEvent(dpy, EnterWindowMask, &ev));
 	if ((m = recttomon(c->x, c->y, c->w, c->h)) != selmon) {
@@ -1991,7 +2020,10 @@ setup(void)
 	dwmatom[DwmMons] = XInternAtom(dpy, "_DWM_RESTART_MONITORS", False);
 	/* init cursors */
 	cursor[CurNormal] = drw_cur_create(drw, XC_left_ptr);
-	cursor[CurResize] = drw_cur_create(drw, XC_sizing);
+	cursor[CurResize] = drw_cur_create(drw, XC_bottom_right_corner);
+	cursor[CurResizeTL] = drw_cur_create(drw, XC_top_left_corner);
+	cursor[CurResizeTR] = drw_cur_create(drw, XC_top_right_corner);
+	cursor[CurResizeBL] = drw_cur_create(drw, XC_bottom_left_corner);
 	cursor[CurMove] = drw_cur_create(drw, XC_fleur);
 	/* init appearance */
 	scheme = ecalloc(LENGTH(colors), sizeof(Clr *));
