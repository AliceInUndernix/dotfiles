+	int px, py, nx, ny, nw, nh, ex, ey, left, top, di;
+	unsigned int dui;
+	Window dummy;
 	Client *c;
 	Monitor *m;
 	XEvent ev;
@@ -1690,12 +1693,20 @@ resizemouse(const Arg *arg)
 	if (c->isfullscreen) /* no support resizing fullscreen windows by mouse */
 		return;
 	restack(selmon);
-	ocx = c->x;
-	ocy = c->y;
+	/* resize from the corner nearest the pointer; the opposite corner stays */
+	if (!XQueryPointer(dpy, c->win, &dummy, &dummy, &di, &di, &px, &py, &dui))
+		return;
+	left = px < c->w / 2;
+	top = py < c->h / 2;
+	ex = c->x + c->w + 2 * c->bw; /* opposite outer edges */
