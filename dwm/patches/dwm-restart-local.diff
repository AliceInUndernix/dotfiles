+/* restart: end the event loop, then main() runs dwm again in place
+ * (same X session, the new binary if it was reinstalled). Every window
+ * keeps its tags, monitor, order and floating position; each monitor
+ * keeps its tags in view and every tag its layout, mfact and nmaster. */
+void
+restart(const Arg *arg)
+{
+	restarting = 1;
+	running = 0;
+}
+
+/* per monitor on the root window: num, seltags, tagset[0..1], curtag,
+ * prevtag, showbar, then for every pertag slot: nmaster, mfact * 10000,
+ * sellt, layout index of lt[0] and lt[1], selected window */
+#define MONHEAD 7
+#define MONSLOT 6
+#define MONREC  (MONHEAD + MONSLOT * (LENGTH(tags) + 1))
+
+static long
+layoutindex(const Layout *l)
+{
+	long i;
+
+	for (i = 0; i < (long)LENGTH(layouts); i++)
+		if (l == &layouts[i])
+			return i;
+	return 0;
+}
+
+void
+savestate(void)
+{
+	Monitor *m;
+	Client *c;
+	long rec[8], *mrec, *r, idx = 0;
+	unsigned int i, nmons = 0;
+
+	for (m = mons; m; m = m->next)
+		nmons++;
+	mrec = ecalloc(nmons * MONREC, sizeof(long));
+	for (m = mons, r = mrec; m; m = m->next, r += MONREC) {
+		r[0] = m->num;
+		r[1] = m->seltags;
+		r[2] = m->tagset[0];
+		r[3] = m->tagset[1];
+		r[4] = m->pertag->curtag;
+		r[5] = m->pertag->prevtag;
+		r[6] = m->showbar;
+		for (i = 0; i <= LENGTH(tags); i++) {
+			long *s = r + MONHEAD + MONSLOT * i;
+			s[0] = m->pertag->nmasters[i];
+			s[1] = (long)(m->pertag->mfacts[i] * 10000 + 0.5);
+			s[2] = m->pertag->sellts[i];
+			s[3] = layoutindex(m->pertag->ltidxs[i][0]);
+			s[4] = layoutindex(m->pertag->ltidxs[i][1]);
+			s[5] = m->pertag->sel[i] ? (long)m->pertag->sel[i]->win : 0;
+		}
+		for (c = m->clients; c; c = c->next) {
+			rec[0] = idx++;
+			rec[1] = c->tags;
+			rec[2] = m->num;
+			rec[3] = c->isfloating;
+			rec[4] = c->x;
+			rec[5] = c->y;
+			rec[6] = c->w;
+			rec[7] = c->h;
+			XChangeProperty(dpy, c->win, dwmatom[DwmClient], XA_CARDINAL, 32,
+				PropModeReplace, (unsigned char *)rec, 8);
+		}
+	}
+	XChangeProperty(dpy, root, dwmatom[DwmMons], XA_CARDINAL, 32,
+		PropModeReplace, (unsigned char *)mrec, nmons * MONREC);
+	free(mrec);
+	XSync(dpy, False);
+}
+
+void
+restorestate(void)
+{
+	Monitor *m;
+	Client *c;
+	long *mrec = NULL, *r, *s;
+	unsigned long n, k;
+	unsigned int i;
+	Monitor *focusmon = selmon;
+
+	if (!getlongprop(root, dwmatom[DwmMons], &mrec, &n))
+		return;
+	XDeleteProperty(dpy, root, dwmatom[DwmMons]);
+	for (k = 0; k + MONREC <= n; k += MONREC) {
+		r = mrec + k;
+		for (m = mons; m && m->num != r[0]; m = m->next);
+		if (!m)
+			continue;
+		m->seltags = r[1] & 1;
+		m->tagset[0] = r[2] & (TAGMASK | scratchtag) ? r[2] & (TAGMASK | scratchtag) : 1;
+		m->tagset[1] = r[3] & (TAGMASK | scratchtag) ? r[3] & (TAGMASK | scratchtag) : 1;
+		if (r[4] >= 0 && r[4] <= (long)LENGTH(tags))
+			m->pertag->curtag = r[4];
+		if (r[5] >= 0 && r[5] <= (long)LENGTH(tags))
+			m->pertag->prevtag = r[5];
+		if (m->showbar != !!r[6]) {
+			m->showbar = !!r[6];
+			updatebarpos(m);
+			XMoveResizeWindow(dpy, m->barwin, m->wx, m->by, m->ww, bh);
+		}
+		for (i = 0; i <= LENGTH(tags); i++) {
+			s = r + MONHEAD + MONSLOT * i;
+			m->pertag->nmasters[i] = MAX(s[0], 0);
+			if (s[1] >= 500 && s[1] <= 9500)
+				m->pertag->mfacts[i] = s[1] / 10000.0;
+			m->pertag->sellts[i] = s[2] & 1;
+			if (s[3] >= 0 && s[3] < (long)LENGTH(layouts))
+				m->pertag->ltidxs[i][0] = &layouts[s[3]];
+			if (s[4] >= 0 && s[4] < (long)LENGTH(layouts))
+				m->pertag->ltidxs[i][1] = &layouts[s[4]];
+			c = s[5] ? wintoclient((Window)s[5]) : NULL;
+			m->pertag->sel[i] = c && c->mon == m ? c : NULL;
+		}
+		i = m->pertag->curtag;
+		m->nmaster = m->pertag->nmasters[i];
+		m->mfact = m->pertag->mfacts[i];
+		m->sellt = m->pertag->sellts[i];
+		m->lt[m->sellt] = m->pertag->ltidxs[i][m->sellt];
+		m->lt[m->sellt ^ 1] = m->pertag->ltidxs[i][m->sellt ^ 1];
+		/* the scratchpad's tag is only in view if there is a scratchpad */
+		for (c = m->clients; c && !(c->tags & scratchtag); c = c->next);
+		if (!c)
+			m->tagset[m->seltags] &= ~scratchtag;
+		if (!m->tagset[m->seltags])
+			m->tagset[m->seltags] = 1;
+	}
+	XFree(mrec);
+	for (m = mons; m; m = m->next) {
+		selmon = m;
+		arrange(m);
+		focus(m->pertag->sel[m->pertag->curtag]);
+	}
+	selmon = focusmon;
+	focus(selmon->pertag->sel[selmon->pertag->curtag]);
+	drawbars();
+}
+
+/* sendrestart: what "dwm restart" does: ask the dwm running on $DISPLAY
+ * to restart. Returns 0 if no dwm is running there. */
+int
+sendrestart(void)
+{
+	XEvent ev;
+	Atom real, check, name, utf8;
+	int format, ok = 0;
+	unsigned long n, extra;
+	unsigned char *p = NULL;
+	Window wm = None, r = DefaultRootWindow(dpy);
+
+	check = XInternAtom(dpy, "_NET_SUPPORTING_WM_CHECK", False);
+	name = XInternAtom(dpy, "_NET_WM_NAME", False);
+	utf8 = XInternAtom(dpy, "UTF8_STRING", False);
+	if (XGetWindowProperty(dpy, r, check, 0L, 1L, False, XA_WINDOW,
+		&real, &format, &n, &extra, &p) == Success && p) {
+		if (n == 1)
+			wm = *(Window *)p;
+		XFree(p);
+		p = NULL;
+	}
+	if (wm != None && XGetWindowProperty(dpy, wm, name, 0L, 16L, False, utf8,
+		&real, &format, &n, &extra, &p) == Success && p) {
+		ok = n == 3 && !strncmp((char *)p, "dwm", 3);
+		XFree(p);
+	}
+	if (!ok)
+		return 0;
+	memset(&ev, 0, sizeof ev);
+	ev.xclient.type = ClientMessage;
+	ev.xclient.window = r;
+	ev.xclient.message_type = XInternAtom(dpy, "_DWM_RESTART", False);
+	ev.xclient.format = 32;
+	XSendEvent(dpy, r, False, SubstructureRedirectMask | SubstructureNotifyMask, &ev);
+	XSync(dpy, False);
+	return 1;
+}
