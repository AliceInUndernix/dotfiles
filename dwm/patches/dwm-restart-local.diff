+/* getlongprop: a CARDINAL property as an array of longs (XFree it) */
+int
+getlongprop(Window w, Atom prop, long **p, unsigned long *n)
+{
+	int format;
+	unsigned long extra;
+	Atom real;
+	unsigned char *data = NULL;
+
+	*p = NULL;
+	*n = 0;
+	if (XGetWindowProperty(dpy, w, prop, 0L, 4096L, False, XA_CARDINAL,
+		&real, &format, n, &extra, &data) != Success || !data)
+		return 0;
+	if (real != XA_CARDINAL || format != 32 || *n == 0) {
+		XFree(data);
+		*n = 0;
+		return 0;
+	}
+	*p = (long *)data;
+	return 1;
+}
