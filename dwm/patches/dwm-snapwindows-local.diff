+/* Snap along one axis (vert: 0 x, 1 y). a and b are the outer edges that
+ * may snap (pass the same for one edge), lo..hi the window's extent on the
+ * other axis. Targets are the monitor's window area edges (within snap) and
+ * the outer edges of other visible windows on the monitor that are level
+ * with it (within winsnap). Sets *d to the nearest shift, returns 0 if none. */
+int
+snapto(Client *c, int vert, int a, int b, int lo, int hi, int *d)
+{
+	Client *o;
+	Monitor *m = c->mon;
+	int t[2], e[2], i, j, olo, ohi, dd, lim, found = 0;
+
+	e[0] = a;
+	e[1] = b;
+	t[0] = vert ? m->wy : m->wx;
+	t[1] = t[0] + (vert ? m->wh : m->ww);
+	o = NULL;
+	lim = snap;
+	for (;;) {
+		for (i = 0; i < 2; i++)
+			for (j = 0; j < 2; j++) {
+				dd = t[j] - e[i];
+				if (abs(dd) < lim && (!found || abs(dd) < abs(*d))) {
+					*d = dd;
+					found = 1;
+				}
+			}
+		for (o = o ? o->next : m->clients; o; o = o->next) {
+			if (o == c || !ISVISIBLE(o) || o->isfullscreen)
+				continue;
+			olo = vert ? o->x : o->y;
+			ohi = olo + (vert ? WIDTH(o) : HEIGHT(o));
+			if (ohi + (int)winsnap < lo || olo - (int)winsnap > hi)
+				continue; /* not level with it */
+			break;
+		}
+		if (!o)
+			break;
+		t[0] = vert ? o->y : o->x;
+		t[1] = t[0] + (vert ? HEIGHT(o) : WIDTH(o));
+		lim = winsnap;
+	}
+	return found;
+}
