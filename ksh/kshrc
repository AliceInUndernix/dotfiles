# Korn shell settings for interactive shells (read through $ENV, which
# ~/.profile sets). Works in ksh93, mksh and OpenBSD ksh.

case $- in *i*) ;; *) return 0 2>/dev/null ;; esac

set -o emacs              # emacs keys on the command line (Ctrl+a, Ctrl+e, arrows)
set -o noclobber          # > will not overwrite a file; >| does

# One history file shared by every open shell: a command run in one
# terminal can be found with the arrows in the others. ksh has no
# "unlimited", so a million commands stands in for it.
HISTFILE=$HOME/.ksh_history
HISTSIZE=1000000
# Up/Down with text typed find older commands starting with that text;
# with an empty line they go through all of history (ksh93 does this).

# Prompt: folder (~ for home), then $ for you or # for root,
# e.g. "~/dotfiles $ " and "/etc # ".
_pwd() {
	case $PWD in
	"$HOME") printf '~' ;;
	"$HOME"/*) printf '~%s' "${PWD#"$HOME"}" ;;
	*) printf '%s' "$PWD" ;;
	esac
}
if [ "$(id -u)" -eq 0 ]; then PS1='$(_pwd) # '; else PS1='$(_pwd) $ '; fi

alias ls='ls -F'          # / after folders, * after programs, @ after links; no colours
alias ll='ls -lh'
alias la='ls -lAh'
alias grep='grep --color=auto'
alias v='nvim'
alias ..='cd ..'
