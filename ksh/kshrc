# Korn shell settings for interactive shells (read through $ENV, which
# ~/.profile sets). Works in ksh93, mksh and OpenBSD ksh.

case $- in *i*) ;; *) return 0 2>/dev/null ;; esac

set -o emacs              # emacs keys on the command line (Ctrl+a, Ctrl+e, arrows)
set -o noclobber          # > will not overwrite a file; >| does

# One history file shared by every open shell: a command run in one
# terminal can be found with the arrows in the others. ksh has no
# "unlimited", so a million commands stands in for it.
# It is in ~/.system/state/ksh (install.sh moves an old ~/.ksh_history).
HISTFILE=${XDG_STATE_HOME:-$HOME/.system/state}/ksh/history
[ -d "${HISTFILE%/*}" ] || mkdir -p "${HISTFILE%/*}"
HISTSIZE=1000000
# Up/Down search history for commands that start with what you typed
# (all commands if the line is empty), both ways: Down goes back to newer
# matches and, past the newest, to what you typed. Each command shows
# once, even if you ran it many times. ksh93 only (its KEYBD trap); its
# own Up already searches like this, but its Down does not. Other ksh
# keep their plain arrows.
case ${KSH_VERSION:-} in *93*) eval "$(cat <<'EOF'
_hs_key() {
	typeset dir l n t
	case ${.sh.edchar} in
	$'\e[A'|$'\eOA') dir=up ;;
	$'\e[B'|$'\eOB') dir=down ;;
	*) _hs_on= ; return ;;
	esac
	# a new search, unless the last key was an arrow and the line is
	# still what it showed
	if [[ -z $_hs_on || ${.sh.edtext} != "$_hs_shown" ]]; then
		_hs_on=1 _hs_i=0 _hs_prefix=${.sh.edtext}
		unset _hs_list _hs_seen; typeset -a _hs_list; typeset -A _hs_seen
		n=0
		# Only ksh's own commands here, no pipes or programs: running
		# one from this trap (the old "hist | awk") left the terminal
		# out of line-editing mode in UTF-8, so the next arrow printed
		# ^[[A instead of doing nothing.
		t=$(hist -lnr -$HISTSIZE 2>/dev/null)
		while IFS= read -r l; do
			[[ $l == $'\t'* ]] || continue     # commands start with a Tab
			l=${l#$'\t'}
			[[ $l == "$_hs_prefix"?* && -z ${_hs_seen[$l]-} ]] || continue
			_hs_seen[$l]=1 _hs_list[n++]=$l
		done <<< "$t"
		unset _hs_seen
	fi
	if [[ $dir == up ]]; then
		(( _hs_i < ${#_hs_list[@]} )) || { .sh.edchar= ; return; }
		(( _hs_i++ ))
	else
		(( _hs_i > 0 )) || { .sh.edchar= ; return; }
		(( _hs_i-- ))
	fi
	if (( _hs_i == 0 )); then l=$_hs_prefix; else l=${_hs_list[_hs_i-1]}; fi
	_hs_shown=$l
	# replace the line: Ctrl+A, Ctrl+K, then the text, with Ctrl+V before
	# control characters (a Tab would otherwise complete)
	.sh.edchar=$'\001\013'"${l//@([[:cntrl:]])/$'\026'\1}"
}
trap _hs_key KEYBD
EOF
)" ;; esac

# Prompt: folder (~ for home), then $ for you or # for root,
# e.g. "~/dotfiles $ " and "/etc # ".
_pwd() {
	case $PWD in
	"$HOME") printf '~' ;;
	"$HOME"/*) printf '~%s' "${PWD#"$HOME"}" ;;
	*) printf '%s' "$PWD" ;;
	esac
}
if [ "$(id -u)" -eq 0 ]; then PS1='$(_pwd) # '; else PS1='$(_pwd) $ '; fi

alias ls='ls -F'          # / after folders, * after programs, @ after links; no colours
alias ll='ls -lh'
alias la='ls -lAh'
alias grep='grep --color=auto'
alias v='nvim'
alias ..='cd ..'
