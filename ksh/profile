# Login settings, read once when you log in (linked to ~/.profile).

export EDITOR=nvim VISUAL=nvim PAGER=less
# less: searches ignore case unless they have a capital letter (-i), quit
# when the text fits on one screen (-F), show colours, e.g. git's (-R).
export LESS=-iFR
# New files and folders are yours alone (root can still read them).
# Not for root: files it makes in /etc or /usr must stay readable.
[ "$(id -u)" -eq 0 ] || umask 077

export ENV=$HOME/.kshrc     # ksh reads this for every interactive shell

# Where programs keep their files: settings in ~/.config, everything else
# in ~/.system, so nothing goes to ~/.local or ~/.cache:
#   share   data: fonts, Neovim plugins, QMK
#   state   history and logs: ksh history, Neovim undo, the X login cookie
#   cache   things that can be thrown away
export XDG_CONFIG_HOME=$HOME/.config
export XDG_DATA_HOME=$HOME/.system/share
export XDG_STATE_HOME=$HOME/.system/state
export XDG_CACHE_HOME=$HOME/.system/cache
mkdir -p "$XDG_STATE_HOME"
export XAUTHORITY=$XDG_STATE_HOME/Xauthority  # startx's cookie, not ~/.Xauthority

# PATH, most important first:
#   ~/.system/bin   every program installed for you: dwm, st, dmenu,
#                   slock, qmk, vim -> nvim, ... (wins over all)
#   then the system's
# It is moved to the front even if the system already put it in PATH
# (at the end, say), so `vim` always runs Neovim and not /usr/bin/vim.
# ~/.local/bin is not used (install.sh moves what was there).
_drop() {        # take $1 out of PATH, wherever it is
	_p=:$PATH:
	while :; do
		case $_p in
		*":$1:"*) _p=${_p%%":$1:"*}:${_p#*":$1:"} ;;
		*) break ;;
		esac
	done
	_p=${_p#:}; PATH=${_p%:}
}
_drop "$HOME/.local/bin"
_drop "$HOME/.system/bin"
PATH=$HOME/.system/bin${PATH:+:$PATH}
unset _p; unset -f _drop
export PATH

# Logging in on the first console (tty1) starts X; logging out of X logs
# you out. The other consoles (Ctrl+Alt+F2...) stay text, for when X
# breaks. Never for root.
if [ -z "${DISPLAY:-}" ] && [ "$(id -u)" -ne 0 ] && [ "$(tty)" = /dev/tty1 ]; then
	exec startx
fi
