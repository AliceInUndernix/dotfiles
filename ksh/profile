# Login settings, read once when you log in (linked to ~/.profile).

export EDITOR=nvim VISUAL=nvim PAGER=less
# ksh switches to vi keys on the command line whenever EDITOR or VISUAL
# gets a name with "vi" in it (nvim does), so reading this file again
# (. ~/.profile) left the shell in vi mode: arrows, Delete and Tab did
# odd things and ~ turned letters into capitals. Back to emacs keys,
# as in kshrc.
case ${KSH_VERSION:-} in ?*) set -o emacs ;; esac
# less: searches ignore case unless they have a capital letter (-i), quit
# when the text fits on one screen (-F), show colours, e.g. git's (-R).
export LESS=-iFR
# New files and directories are yours alone (root can still read them).
# Not for root: files it makes in /etc or /usr must stay readable.
[ "$(id -u)" -eq 0 ] || umask 077

# Where programs keep their files: all in ~/.system, so nothing goes
# to ~/.cache, and in ~ there are only two links, this file
# (~/.profile) and ~/.config (-> .system/config, for programs that
# don't ask XDG_CONFIG_HOME):
#   config  settings: ksh, X, Neovim, tmux, ... (links into the dotfiles)
#   share   data: fonts, Neovim plugins, QMK
#   state   history and logs: ksh history, Neovim undo, the X login cookie
#   (caches are not settings: they stay in ~/.cache, set by the programs)
export XDG_CONFIG_HOME=$HOME/.system/config
export XDG_DATA_HOME=$HOME/.system/share
export XDG_STATE_HOME=$HOME/.system/state
unset XDG_CACHE_HOME
mkdir -p "$XDG_STATE_HOME"
export XAUTHORITY=$XDG_STATE_HOME/Xauthority  # startx's cookie, not ~/.Xauthority
export ENV=$XDG_CONFIG_HOME/ksh/kshrc   # ksh reads it in every interactive shell
export XINITRC=$XDG_CONFIG_HOME/x/xinitrc   # what startx runs, not ~/.xinitrc

# PATH, most important first:
#   ~/.system/bin   every program installed for you: dwm, st, dmenu,
#                   slock, qmk, vim -> nvim, ... (wins over all)
#   then the system's
# It is moved to the front even if the system already put it in PATH
# (at the end, say), so `vim` always runs Neovim and not /usr/bin/vim.
# ~/.local/bin is not used (install.sh moves what was there).
_drop() {        # take $1 out of PATH, wherever it is
	_p=:$PATH:
	while :; do
		case $_p in
		*":$1:"*) _p=${_p%%":$1:"*}:${_p#*":$1:"} ;;
		*) break ;;
		esac
	done
	_p=${_p#:}; PATH=${_p%:}
}
_drop "$HOME/.local/bin"
_drop "$HOME/.system/bin"
PATH=$HOME/.system/bin${PATH:+:$PATH}
unset _p; unset -f _drop
export PATH

# seal: the links to directories unsealed into RAM die with a reboot or
# a crash; each login takes the dead ones away (seal/README).
command -v seal >/dev/null 2>&1 && seal -c -q

# Logging in on the first console (tty1) starts X; logging out of X logs
# you out. The other consoles (Ctrl+Alt+F2...) stay text, for when X
# breaks. Never for root.
if [ -z "${DISPLAY:-}" ] && [ "$(id -u)" -ne 0 ] && [ "$(tty)" = /dev/tty1 ]; then
	exec startx
fi
