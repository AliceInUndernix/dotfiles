#!/bin/sh
# proxychains for net/ (vpn): runs a program through Tor on a SOCKS
# port of its own (9100-9199 in /etc/tor/torrc), so no two programs
# share Tor circuits or exits, and a site can't link one program to
# another by the exit it comes from. The same program always gets the
# same port; the list is ~/.system/state/proxychains/ports ("name
# port", one per line: delete a line to free its port).
# Installed as /usr/local/bin/proxychains by install.sh net; the real
# proxychains-ng is /usr/bin/proxychains4 or /usr/bin/proxychains, run
# with /etc/proxychains.d/PORT.conf.
#
#   proxychains [-q] PROGRAM [ARGS]   PROGRAM on its own port
#   proxychains -l                    the programs and their ports
#   proxychains -f FILE PROGRAM       that config, as proxychains4 does

FIRST=9100
LAST=9199
CONFS=/etc/proxychains.d

say() { printf '%s\n' "$*"; }
die() { printf 'proxychains: %s\n' "$*" >&2; exit 1; }

real=
# Gentoo's is /usr/bin/proxychains (this one is /usr/local/bin's)
for p in /usr/bin/proxychains4 /usr/bin/proxychains; do
    if [ -x "$p" ]; then
        real=$p
        break
    fi
done
[ -n "$real" ] ||
    die "proxychains4 is missing (emerge -qv net-misc/proxychains)"

state=${XDG_STATE_HOME:-$HOME/.system/state}/proxychains
list=$state/ports

quiet=
while [ $# -gt 0 ]; do
    case $1 in
    -q) quiet=-q; shift ;;
    -f) exec "$real" $quiet "$@" ;;
    -l)
        if [ -s "$list" ]; then
            sort -k 2 -n "$list"
        else
            say "no program has a port yet"
        fi
        exit 0 ;;
    -h|--help) sed -n '2,15s/^# \{0,1\}//p' "$0"; exit 0 ;;
    --) shift; break ;;
    -*) die "unknown option $1 (proxychains -h)" ;;
    *) break ;;
    esac
done
[ $# -gt 0 ] || die "which program? (proxychains -h)"

# the program's name: letters, digits, . _ - only
name=$(say "${1##*/}" | tr -c 'A-Za-z0-9._\n-' '_')

if ! mkdir -p "$state" 2>/dev/null || ! touch "$list" 2>/dev/null; then
    [ -n "$quiet" ] ||
        say "proxychains: can't write $list: the shared port 9050" >&2
    exec "$real" $quiet "$@"
fi

port=$(awk -v n="$name" '$1 == n { print $2; exit }' "$list")
if [ -z "$port" ]; then
    port=$(awk -v f=$FIRST -v l=$LAST '
        { used[$2] = 1 }
        END { for (p = f; p <= l; p++) if (!(p in used)) { print p; exit } }
    ' "$list")
    [ -n "$port" ] ||
        die "all ports $FIRST-$LAST are taken: delete lines in $list"
    say "$name $port" >> "$list"
    [ -n "$quiet" ] || say "proxychains: $name gets Tor port $port" >&2
fi
[ -r "$CONFS/$port.conf" ] ||
    die "$CONFS/$port.conf is missing: su -c '~/dotfiles/install.sh net'"
exec "$real" $quiet -f "$CONFS/$port.conf" "$@"
