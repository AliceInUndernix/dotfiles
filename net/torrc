# the system's DNS: resolv.conf says 127.0.0.1 and the firewall sends
# port 53 here (not 53 itself, so Tor needs no root for it)
DNSPort 127.0.0.1:9053
# vpn level 3 (everything through Tor) and .onion addresses
TransPort 127.0.0.1:9040
# .onion names get a fake address from this range; the firewall sends
# connections to it into Tor, so onion sites work in every program
AutomapHostsOnResolve 1
VirtualAddrNetworkIPv4 10.192.0.0/10

# --- the safest client settings

# only a client: never a relay, a bridge or a directory for others
ClientOnly 1
# vanguards-lite: a small fixed set of second-hop relays for onion
# circuits, against guard discovery (the full vanguards of tor exist
# only as a separate Python add-on, so not here)
VanguardsLiteEnabled 1
# Tor runs in a seccomp sandbox: a hole in Tor reaches far less of the
# system. install.sh net builds tor with USE=seccomp for it (and takes
# this line out only if that build failed: tor would not start).
Sandbox 1
# padding on the link to the guard, against traffic analysis there
ConnectionPadding 1
ClientUseIPv6 0
AvoidDiskWrites 1
SafeLogging 1
# warnings only, in /run (gone after a reboot)
Log warn file /run/vpn/tor.log

# --- bridges: not on yet. They hide from your ISP (and Riseup) that you
# use Tor. They need a pluggable transport program (lyrebird for obfs4)
# and bridge lines. Then take the # off these and add your lines:
#UseBridges 1
#ClientTransportPlugin obfs4 exec /usr/bin/lyrebird
#Bridge obfs4 IP:PORT FINGERPRINT cert=... iat-mode=0
