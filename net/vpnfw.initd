#!/sbin/openrc-run
# The kill switch (net/ in the dotfiles). In the boot runlevel, so it
# closes the network before dhcpcd brings it up, and gives each network
# card a random MAC address while it is still down. Installed as
# /etc/init.d/vpnfw.

description="Kill switch: no network but Riseup's servers until vpn says"

depend() {
    need localmount
    before net
}

start() {
    ebegin "Closing the network (IPv6 off, IPv4 only to Riseup)"
    /usr/local/bin/vpn boot
    eend $?
}

stop() {
    # the rules stay: stopping this never opens the network
    return 0
}
