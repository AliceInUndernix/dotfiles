#!/bin/sh
# Start Plover from ~/.system/plover (install.sh links this to
# ~/.system/bin/plover). Started in a folder that holds plover.cfg, Plover
# keeps everything there ("portable mode"): settings, plugins, dictionaries,
# strokes.log. Nothing goes to ~/.config or ~/.local.
#
# --python skips the AppImage launcher's own start step, which asks for
# your password (pkexec) to add a udev rule for /dev/uinput. That is only
# for Wayland; on X11 (dwm) Plover types through X.
#
#   plover                                  start it
#   plover -s plover_plugins install <pkg>  add a plugin
# Plover 5 types through X only when XDG_SESSION_TYPE is x11. startx
# leaves it at tty, and then Plover uses uinput, which types characters
# that aren't on the keyboard (“ ” ’ …) as Ctrl+Shift+U + hex code: that
# only works with ibus or fcitx5 and comes out as garbage in st.
if [ -n "$DISPLAY" ] && [ -z "$WAYLAND_DISPLAY" ]; then
	export XDG_SESSION_TYPE=x11
fi
dir=$HOME/.system/plover
cd "$dir" || exit 1
# Without plover.cfg here Plover leaves portable mode and uses
# ~/.config/plover instead, so put the first settings back if it's gone.
if [ ! -f plover.cfg ]; then
	cp "$(dirname "$(readlink -f "$0")")/plover.cfg" plover.cfg || exit 1
fi
exec "$dir/app/AppRun" --python -s -m plover.scripts.dist_main "$@"
