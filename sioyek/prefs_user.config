# Sioyek settings (linked to ~/.config/sioyek/prefs_user.config).
# Only what differs from Sioyek's defaults; its own prefs.config has the rest.
# Colours are red green blue from 0 to 1 (Habamax: #1c1c1c is 0.110).

# Pages in Habamax colours from the start: grey text on #1c1c1c.
# Toggle back to the book's own colours with the toggle_custom_color command.
startup_commands toggle_custom_color
custom_background_color 0.110 0.110 0.110
custom_text_color       0.780 0.780 0.780
# Around the pages: a little darker than the paper (#161616), so you see
# where a page ends. The development version uses the first one in the
# Habamax (custom colour) mode and was pitch black without it.
custom_color_mode_empty_background_color 0.086 0.086 0.086
background_color                         0.086 0.086 0.086
dark_mode_background_color               0.086 0.086 0.086

# Status bar and menus.
ui_font                      Liberation Mono
font_size                    25
status_bar_color             0.110 0.110 0.110
status_bar_text_color        0.780 0.780 0.780
ui_background_color          0.110 0.110 0.110
ui_text_color                0.780 0.780 0.780
ui_selected_background_color 0.373 0.529 0.686
ui_selected_text_color       0.110 0.110 0.110

# Search matches and selected text: Habamax blue.
search_highlight_color 0.373 0.529 0.686
text_highlight_color   0.373 0.529 0.686

# Highlights g and r are what Neovim's :TypeTrack uses for right and wrong
# words: Habamax's green (#87af87) and red (#af5f5f).
highlight_color_g 0.529 0.686 0.529
highlight_color_r 0.686 0.373 0.373
