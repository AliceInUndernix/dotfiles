#!/bin/sh
# Started by startx (linked to ~/.xinitrc by install.sh).

# Wallpaper: Habamax's background colour, same as st, tmux and Neovim.
xsetroot -solid "#1c1c1c"

# Sound: start PipeWire and WirePlumber (Gentoo without systemd; with
# systemd they start by themselves as user services).
if [ ! -d /run/systemd/system ] && command -v gentoo-pipewire-launcher >/dev/null 2>&1; then
	gentoo-pipewire-launcher &
fi

# Idle lock. 0 = never blank, lock or turn off the screen on its own.
# Set a number of minutes (e.g. 10) to blank and lock after that long idle.
# Restart X (Mod+Shift+q, then startx) for a change to take effect.
IDLE_LOCK_MINUTES=0

if [ "$IDLE_LOCK_MINUTES" -gt 0 ]; then
	idle=$((IDLE_LOCK_MINUTES * 60))
	xset s "$idle" "$idle"
	xset +dpms dpms "$idle" "$idle" "$idle"
else
	xset s off
	xset -dpms
fi

# xss-lock runs slock when the screen blanks (only if the idle lock above
# is on) and always before the laptop suspends, so waking needs the
# password. Mod+Shift+l locks by hand, Mod+Shift+s suspends.
xss-lock -- slock &

# Status text on the right of dwm's bar (Mod+b shows the bar): the date
# and time, updated at the start of every minute. See date(1) for the
# % codes in STATUS_DATE.
STATUS_DATE="%H:%M %Z, %A, %d %B %Y"
while true; do
	xsetroot -name "$(date +"$STATUS_DATE")"
	sleep $((60 - $(date +%S | sed 's/^0//')))
done &

# dwm runs until you quit it (Mod+Shift+q), which ends the X session.
exec dwm
